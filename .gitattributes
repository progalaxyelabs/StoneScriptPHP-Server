# Packagist installs come from GitHub's zipball, which honours export-ignore (and NOT composer.json
# "archive.exclude"). Keep maintainer-only material out of what `composer create-project` delivers.
# tests/ ships on purpose: a new project keeps the auth smoke test, so a broken auth wiring shows up.
/docs                     export-ignore
/.github                  export-ignore
/.gitattributes           export-ignore
/.phpunit.cache           export-ignore
# Maintainer metadata and internal/dev files never ship in the zip.
/project-info.yaml        export-ignore
/CLAUDE.md                export-ignore
/HLD.md                   export-ignore
/SPEC.md                  export-ignore
/*STATUS*.md              export-ignore
/*HANDOFF*.md             export-ignore
/test-docker*             export-ignore
/local-tests              export-ignore
