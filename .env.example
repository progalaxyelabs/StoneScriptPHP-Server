# StoneScriptPHP environment configuration.
#
# This file must match the typed properties on StoneScriptPHP\Env (and this
# app's own App\AppEnv extension) — the framework reads env vars by exact
# name via reflection, so a stale/renamed key here silently does nothing.
# `composer create-project` copies this file to .env and generates the JWT
# keypair; edit .env afterwards. Everything in this file is read by the
# framework, so a value set here is the single source of truth
# (src/config/auth.php leaves mode, server url and platform code as `null` so
# they come from this file).
#
# REQUIRED values are left EMPTY on purpose. A forgotten value must stop the app
# at boot with a clear message, not run quietly against a placeholder.

# ── Application ─────────────────────────────────────────────────────────────
DEBUG_MODE=false
TIMEZONE=UTC
APP_NAME="My API"
APP_ENV=development
APP_PORT=9100

# ── Database transport (gateway-only architecture, v3+) ─────────────────────
# DB_MODE selects the transport: gateway (default, required for prod) | direct
# (raw PDO to Postgres, needs ext-pdo_pgsql) | pgandroid (on-device embed).
DB_MODE=gateway

# REQUIRED when DB_MODE=gateway (the default) — boot fails loud without these.
# DB_GATEWAY_URL is the StoneScriptDB Gateway (e.g. http://localhost:9000 in
# development); DB_GATEWAY_PLATFORM is the platform code registered in it.
DB_GATEWAY_URL=
DB_GATEWAY_PLATFORM=
DB_GATEWAY_SCHEMA_NAME=main
# Only needed for multi-tenant platforms:
# DB_GATEWAY_TENANT_SCHEMA_NAME=tenant
DB_GATEWAY_ADMIN_TOKEN=
# DB_GATEWAY_PLATFORM_TOKEN=   # optional pinned per-platform token; auto-provisioned if unset
# Read by the `php stone gateway:*` commands (not by the running API). Keep them equal to
# DB_GATEWAY_PLATFORM and DB_GATEWAY_SCHEMA_NAME above; the commands do not see DB_GATEWAY_*.
# Use a descriptive schema name ("main"), not a version-tagged one ("v1_0").
PLATFORM_ID=
MAIN_SCHEMA_NAME=main
DATABASE_ID=main

# Only used when DB_MODE=direct:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=myapp
# DB_USER=postgres
# DB_PASSWORD=

# ── JWT (the keypair this API signs with: login tokens in builtin mode, and the
#    API tokens that the framework's POST /api/auth/exchange route signs in
#    external/hybrid mode) ─────────────────────────────────────────────────────
# The private key must never be baked into an image or committed: mount it as a
# secret (see DOCKER.md) or point JWT_PRIVATE_KEY_PATH at the mounted file.
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
# JWT_PRIVATE_KEY_PASSPHRASE=
# REQUIRED: this API's own public URL (e.g. https://api.yourdomain.com). It is
# the 'iss' of every token this API signs and the only issuer it trusts for
# them. There is no placeholder default; boot fails while it is empty.
# It must differ from AUTH_ISSUER.
JWT_ISSUER=
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=15552000
API_ACCESS_TOKEN_EXPIRY=3600

# ── Auth mode ────────────────────────────────────────────────────────────────
# builtin  = this API issues/validates its own JWTs (local RSA keys above)
# external = delegate identity to a separate auth service (JWKS-verified)
# hybrid   = validate external JWTs, may also issue local tokens
AUTH_MODE=external

# REQUIRED when AUTH_MODE is external/hybrid (boot fails while empty).
# Network address for JWKS fetch (e.g. http://localhost:3139 in development,
# the container hostname in Docker) — NOT the issuer (see AUTH_ISSUER below).
AUTH_SERVICE_URL=
# The exact 'iss' claim value the auth service stamps into its JWTs. Decode a
# real token from that service and copy its 'iss' field here — do not guess.
AUTH_ISSUER=
# The platform code registered in the auth service.
PLATFORM_CODE=
EXTERNAL_AUTH_CLIENT_SECRET=

# Cookie-mode auth only. Leave AUTH_COOKIE_SECURE unset: an EMPTY value is read as false and
# turns the Secure flag off. Set it to true/false explicitly if you must override the default.
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SECURE=true

# ── CORS / OAuth popup origins ───────────────────────────────────────────────
# The allowed origins live in src/config/allowed-origins.php: list the origin of
# every page that calls this API, INCLUDING your sign-in page (framework 12+:
# the Google OAuth popup posts tokens only to those origins and to the API's
# own origin). Fails closed: no origin listed = no origin allowed.
# Verify with: php stone auth:check-origins
# An ALLOWED_ORIGINS variable (comma-separated) would OVERRIDE that file, so do
# not set both. Leave this unset unless you deploy with env-only configuration.
# ALLOWED_ORIGINS=

# ── Client IP / reverse proxies (framework 11+) ──────────────────────────────
# client_ip() trusts the TCP peer only. If anything sits between the internet
# and PHP (host proxy, load balancer, CDN, Traefik), list THAT proxy here as an
# explicit address or CIDR, otherwise every visitor shares the proxy's address,
# one rate-limit bucket, and the site answers HTTP 429. Leave unset only when
# nginx/PHP-FPM face the internet directly. Do not use the `private` keyword
# unless the backend port is reachable only by the proxy.
# See docs in the framework: docs/CLIENT-IP-AND-NGINX-STANDARD.md
# TRUSTED_PROXIES=10.0.0.5

# ── Email (ZeptoMail) ────────────────────────────────────────────────────────
ZEPTOMAIL_BOUNCE_ADDRESS=bounce@example.com
ZEPTOMAIL_SENDER_EMAIL=noreply@example.com
ZEPTOMAIL_SENDER_NAME="My App"
ZEPTOMAIL_SEND_MAIL_TOKEN=

# Optional: route test-domain recipients to a local Mailpit instance instead
# of ZeptoMail (needs symfony/mailer, a require-dev dependency).
# TEST_EMAIL_DOMAIN=test.example.com
# MAILPIT_SMTP_HOST=localhost
# MAILPIT_SMTP_PORT=1025

EMAIL_VERIFICATION_ENABLED=true

# ── Google OAuth (optional — App\AppEnv) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Security / anti-abuse (optional) ─────────────────────────────────────────
CSRF_SECRET_KEY=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# ── Audit trail (opt-in, separate audit DB — StoneScriptPHP\Audit) ───────────
AUDIT_TRAIL_ENABLED=false

# ── Framework 12 behaviour switches ──────────────────────────────────────────
# A new project starts on the strict settings (the framework's own defaults are
# the lenient 11.x ones, kept only so existing apps upgrade without surprises).
# A failed write is never answered with a 2xx (Database::mutate / ResponseGuard).
PERSISTENCE_CONTRACT=enforced
# SQL NULL stays NULL; a NULL for a non-nullable model property throws.
DB_HYDRATION_MODE=strict
# HEAD runs the GET handler (true) or is only probed (false). A GET route with
# side effects should declare 'head' => 'probe' in src/config/routes.php.
HEAD_EXECUTES_GET=true
# Persist refresh tokens (Postgres). Run `php stone gateway:migrate-vendor-main`
# first, then `php stone auth:check-refresh-store`. Rotation is a separate flag
# (the stock body-mode client does not read a rotated refresh token).
REFRESH_TOKEN_STORE=none
# REFRESH_TOKEN_ROTATE=false

# ── Redis / cache (optional) ──────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PREFIX=stonescript:
CACHE_DEFAULT_TTL=3600
CACHE_ENABLED=true
