# Environment & Credentials
.env
.env.*
!.env.example
*.pem
*.pub
*.key
*-jwt.pem
*-jwt.pub
/credentials*
/secrets/
/.secrets/

# Dependencies
/vendor/
/node_modules/
# composer.lock: commit it in YOUR project (reproducible builds). The skeleton repo itself ships
# without one so create-project resolves the newest framework 12.x patch.

# IDE & Editors
/.idea/
/.vscode/
/.claude/
/.phpunit.cache/
/.phpunit.result.cache
*.swp
*.swo
*~

# Logs
*.log
logs/*
!logs/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Uploads & User Data
/uploads/
/public/uploads/*
!/public/uploads/.gitkeep
/storage/*
!/storage/.gitkeep

# Database
*.sqlite
*.db
/postgresql-data/

# Vendor-provided opt-in schema (regenerated on every composer install/update
# by cli/sync-vendor-schema.php — never hand-edit, never commit)
/src/postgresql/vendor/

# OS Files
.DS_Store
Thumbs.db

# Build & Cache
/dist/
/build/
/.cache/

# Server PID files
.stone-server-*.pid

# Docker test environment
.project-id
